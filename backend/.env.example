# ==========================================
# MboaFind Backend - Variables d'environnement
# Copier ce fichier vers .env puis le remplir.
# Ne JAMAIS committer le fichier .env réel.
# ==========================================

# Environnement : development | testing | production
ENVIRONMENT=development

# Version de l'application
APP_VERSION=0.1.0

# Clé secrète utilisée pour signer les JWT
# En production : générer une longue chaîne aléatoire (ex: openssl rand -hex 32)
SECRET_KEY=change-me-en-production

# Algorithme de signature JWT
ALGORITHM=HS256

# Durée de validité des tokens (minutes). 1440 = 24h
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# URL de connexion à la base de données
# SQLite (développement)
DATABASE_URL=sqlite:///./mboafind.db
# PostgreSQL (production) :
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mboafind

# Origines autorisées pour CORS (liste JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Géocodage automatique (Nominatim/OpenStreetMap) pour positionner une
# boutique sans coordonnées manuelles (vrai par défaut). Mettre à "false"
# en environments sans accès réseau (tests notamment).
GEOCODE_ENABLED=true